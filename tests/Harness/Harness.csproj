<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Harness (D-031, docs/design/harness.md §5): starts the legacy bot process and SimClient processes and
    waits on their events. It references neither the bot nor any Core: processes and files are the only
    bridges (F2). Session 4 (B1a): the characterization scenarios live here too (JoinHandshake, RelayEchoAck,
    HistoryCursor; trait `scenario` selects them in CI). A separate Contract.Tests project (harness.md §5) waits
    until the scenario count justifies it (session-4 decision).
    Inputs come from environment variables (see HarnessConfig.cs); CI sets them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Harness</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
